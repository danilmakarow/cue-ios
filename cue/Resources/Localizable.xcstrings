        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося ввійти"
          }
        }
      }
    },
    "auth.disclaimer": {
      "comment": "Small print under the Sign in with Apple button",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We use your Apple ID to create your Cue account. No password required."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ми використовуємо ваш Apple ID для створення облікового запису Cue. Пароль не потрібен."
          }
        }
      }
    },
    "auth.error.appleCredentialMissing": {
      "comment": "Error shown when Apple did not return the expected sign-in credentials",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
