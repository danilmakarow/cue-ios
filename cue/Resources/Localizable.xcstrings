    "error.network.unreachable": {
      "comment": "Shown when the server can't be reached (transport failure / network error page)",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn't reach the server. Check your connection and try again."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося з'єднатися із сервером. Перевірте підключення та повторіть спробу."
          }
        }
      }
