    "api.userError.forbidden" : {
      "comment" : "Friendly message for HTTP 403",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : { "state" : "translated", "value" : "You don't have permission to do that." }
