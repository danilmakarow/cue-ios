    "api.userError.clientError" : {
      "comment" : "Friendly fallback for 4xx client errors with no parseable body",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : { "state" : "translated", "value" : "The request couldn't be completed." }
        },
        "uk" : {
          "stringUnit" : { "state" : "translated", "value" : "Не вдалося виконати запит." }
        }
      }
    },
    "api.userError.decoding" : {
      "comment" : "Friendly message when the server response can't be parsed",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : { "state" : "translated", "value" : "We received an unexpected response from the server." }
        },
        "uk" : {
          "stringUnit" : { "state" : "translated", "value" : "Сервер надіслав неочікувану відповідь." }
        }
      }
