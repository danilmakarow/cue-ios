{
  "sourceLanguage": "en",
  "strings": {
    "api.error.decoding": {
      "comment": "Error shown when the server response could not be parsed. Parameter is the underlying decoding error.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't parse server response. %@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося обробити відповідь сервера. %@"
          }
        }
      }
    },
    "api.error.httpStatus": {
      "comment": "Error shown when the server returns a non-success status with no body. Parameter is the HTTP status code.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Server returned status %lld."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер повернув статус %lld."
          }
        }
      }
    },
    "api.error.httpStatusWithBody": {
      "comment": "Error shown when the server returns a non-success status with a body. First parameter is the HTTP status code, second is the response body.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Server error (%1$lld): %2$@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Помилка сервера (%1$lld): %2$@"
          }
        }
      }
    },
    "api.error.transport": {
      "comment": "Error shown for a network/transport failure. Parameter is the underlying system error.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Network error: %@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Помилка мережі: %@"
          }
        }
      }
    },
    "api.userError.clientError": {
      "comment": "Friendly fallback for 4xx client errors with no parseable body",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The request couldn't be completed."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося виконати запит."
          }
        }
      }
    },
    "api.userError.decoding": {
      "comment": "Friendly message when the server response can't be parsed",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We received an unexpected response from the server."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер надіслав неочікувану відповідь."
          }
        }
      }
    },
    "api.userError.forbidden": {
      "comment": "Friendly message for HTTP 403",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You don't have permission to do that."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У вас немає дозволу на цю дію."
          }
        }
      }
    },
    "api.userError.notFound": {
      "comment": "Friendly message for HTTP 404",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn't find what you were looking for."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося знайти те, що ви шукали."
          }
        }
      }
    },
    "api.userError.rateLimited": {
      "comment": "Friendly message for HTTP 429",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're doing that too fast. Please wait a moment."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Забагато спроб поспіль. Зачекайте трохи."
          }
        }
      }
    },
    "api.userError.serverError": {
      "comment": "Friendly fallback for 5xx server errors",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server ran into a problem. Please try again."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На сервері сталася помилка. Спробуйте ще раз."
          }
        }
      }
    },
    "api.userError.sessionExpired": {
      "comment": "Friendly message for HTTP 401",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your session has expired. Please sign in again."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш сеанс завершився. Будь ласка, увійдіть знову."
          }
        }
      }
    },
    "api.userError.timeout": {
      "comment": "Friendly message for request timeouts (408, 504)",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The request timed out. Please try again."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Час очікування запиту вичерпано. Спробуйте ще раз."
          }
        }
      }
    },
    "api.userError.unknown": {
      "comment": "Friendly fallback for an unrecognized status. Parameter is the HTTP status code.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something went wrong (status %lld)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щось пішло не так (код %lld)."
          }
        }
      }
    },
    "auth.alert.signInFailed.title": {
      "comment": "Title of the alert shown when Sign in with Apple fails",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't sign in"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося ввійти"
          }
        }
      }
    },
    "auth.disclaimer": {
      "comment": "Small print under the Sign in with Apple button",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We use your Apple ID to create your Cue account. No password required."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ми використовуємо ваш Apple ID для створення облікового запису Cue. Пароль не потрібен."
          }
        }
      }
    },
    "auth.error.appleCredentialMissing": {
      "comment": "Error shown when Apple did not return the expected sign-in credentials",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple didn't return the expected credentials."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple не повернув очікувані облікові дані."
          }
        }
      }
    },
    "auth.error.appleFailed": {
      "comment": "Error shown when Sign in with Apple fails. Parameter is the underlying system error message.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in with Apple failed: %@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося ввійти через Apple: %@"
          }
        }
      }
    },
    "auth.signingIn": {
      "comment": "Progress text shown while a sign-in request is in flight",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signing you in…"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виконуємо вхід…"
          }
        }
      }
    },
    "auth.tagline": {
      "comment": "App tagline on the sign-in and loading screens",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your day, cued just right."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш день — точно за сигналом."
          }
        }
      }
    },
    "calendar.alert.loadFailed.title": {
      "comment": "Title of the alert shown when loading the day's events fails",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
